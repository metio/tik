{:paths ["src" "cli" "skills"]
 :deps {metosin/malli {:mvn/version "0.20.3"}}
 :tasks
 {tik  {:doc "Run the tik CLI (bb tik -- status <id>)"
        :requires ([tik.cli])
        :task (apply tik.cli/-main *command-line-args*)}
  ;; the suite's JVM and every process it starts get one fresh temp
  ;; directory as java.io.tmpdir and TMPDIR, removed when the run ends
  ;; whatever its outcome, so even temp files made outside the test
  ;; harness (a command under test, ssh-keygen, mktemp) cannot outlive it
  test {:doc "Run the JVM test suite (kaocha)"
        :requires ([babashka.fs :as fs])
        :task (let [tmp (str (fs/create-temp-dir {:prefix "tik-test-"}))]
                (try
                  (apply shell {:extra-env {"TMPDIR" tmp}}
                         "clojure" (str "-J-Djava.io.tmpdir=" tmp) "-M:test"
                         *command-line-args*)
                  (finally (fs/delete-tree tmp))))}
  lint {:doc "clj-kondo over the code base"
        :task (shell "clj-kondo --lint src cli test")}
  tla  {:doc "Model-check the TLA+ specs with TLC and prove their inductive invariants with Apalache (spec/); `bb tla tlc` or `bb tla apalache` runs one tool"
        :task (apply shell "bash spec/check.sh" *command-line-args*)}
  analyze {:doc "Deep static analysis (eastwood + splint)"
           :task (do (shell "clojure -M:eastwood")
                     (shell "clojure -M:splint"))}
  fmt  {:doc "Check formatting (cljfmt); `bb fmt fix` rewrites"
        :task (shell (str "clojure -M:cljfmt "
                          (or (first *command-line-args*) "check")))}
  vuln {:doc "Dependency CVE scan (clj-watson; needs GITHUB_TOKEN)"
        :task (shell "clojure -M:watson -p deps.edn -t github-advisory")}
  prose {:doc "Harper grammar over docs/ and kb/ (advisory: wrapped
              markdown trips false positives; not part of the gate)"
         :task (shell {:continue true
                       :extra-env {"HARPER_IGNORE"
                                   (str "LongSentences,MassNouns,SplitWords,"
                                        "SentenceCapitalization,"
                                        "OrthographicConsistency,"
                                        "DisjointPrefixes")}}
                      "ci-harper")}
  mcp  {:doc "MCP server over stdio (TIK_ROOT/TIK_ACTOR/TIK_KEY env)"
        :requires ([tik.mcp])
        :task (tik.mcp/-main)}
  repl {:doc "JVM nREPL with dev+test paths"
        :task (shell "clojure -M:dev")}
  build-native {:doc "Single-binary tik (GraalVM native-image -> target/tik)"
                :task (shell "sh dev/build-native.sh")}
  bench {:doc "Kernel micro-benchmarks (criterium; JMH-grade stats)"
         :task (shell "clojure -M:bench")}
  bench-store {:doc "Macro benchmark: N-ticket store, cold/warm (bb bench-store 5000)"
               :task (shell (str "sh dev/bench-store.sh "
                                 (or (first *command-line-args*) "")))}}}
