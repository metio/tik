;;
;; SYNTHETIC and UNVERIFIED fixture, not recorded from any server. The
;; Odoo 12 Enterprise Helpdesk field names, types, selection values and
;; tracked flags below are guesses from later Odoo versions' documentation
;; and have not been read from an Odoo 12 server; `sla_deadline` in
;; particular may be named `deadline` there. Tests use it only to exercise
;; describe and profile coverage on a second model, never as evidence of
;; what Odoo 12 Helpdesk offers. Replace with a recorded answer once one
;; exists (support intake ticket R1).
{:version {:server_version "12.0"
           :server_version_info [12 0 0 "final" 0 "e"]
           :protocol_version 1}
 :fields {:name {:string "Subject" :type "char" :required true :readonly false}
          :stage_id {:string "Stage" :type "many2one" :relation "helpdesk.stage"
                     :required false :readonly false :track_visibility "onchange"}
          :team_id {:string "Helpdesk Team" :type "many2one" :relation "helpdesk.team"
                    :required false :readonly false :track_visibility "onchange"}
          :user_id {:string "Assigned to" :type "many2one" :relation "res.users"
                    :required false :readonly false :track_visibility "onchange"}
          :partner_id {:string "Customer" :type "many2one" :relation "res.partner"
                       :required false :readonly false}
          :commercial_partner_id {:string "Customer Company" :type "many2one"
                                  :relation "res.partner" :required false :readonly true}
          :priority {:string "Priority" :type "selection" :required false :readonly false
                     :selection [["0" "All"] ["1" "Low priority"] ["2" "High priority"]
                                 ["3" "Urgent"]]
                     :track_visibility "onchange"}
          :ticket_type_id {:string "Ticket Type" :type "many2one" :relation "helpdesk.ticket.type"
                           :required false :readonly false}
          :tag_ids {:string "Tags" :type "many2many" :relation "helpdesk.tag"
                    :required false :readonly false}
          :kanban_state {:string "Kanban State" :type "selection" :required false :readonly false
                         :selection [["normal" "Grey"] ["done" "Green"] ["blocked" "Red"]]
                         :track_visibility "onchange"}
          :sla_deadline {:string "SLA Deadline" :type "datetime" :required false :readonly true}
          :sla_fail {:string "Failed SLA Policy" :type "boolean" :required false :readonly true}
          :create_date {:string "Created on" :type "datetime" :required false :readonly true}
          :message_ids {:string "Messages" :type "one2many" :relation "mail.message"
                        :required false :readonly false}}}
