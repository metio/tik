;;
;; A Redmine issue mirrored by `tik bridge redmine`. The bridge signs what
;; it reads from Redmine under the :bridge role: the issue's status and
;; whether Redmine counts that status as closed, its assignee, priority,
;; tracker, project, subject and due date. The stages derive from that
;; mirrored state, so a reopened issue regresses to :open on the next sync.
;; Facts a person adds locally (links to repositories, notes) never reach
;; Redmine and never move these stages.
{:process/id :redmine-issue
 :process/version 1
 :process/guard-vocab 2
 ;; every stage mirrors Redmine; the judgments behind them are made there
 :lint {:runbooks :off}

 :process/roles
 {:bridge {:members ["redmine"]}}

 :process/facts
 {[:redmine :id]       [:int {:min 1}]
  [:redmine :url]      [:string {:min 8}]
  [:redmine :status]   [:string {:min 1}]
  [:redmine :state]    [:enum :open :closed]
  [:redmine :assignee] [:string {:min 1}]
  [:redmine :priority] [:string {:min 1}]
  [:redmine :tracker]  [:string {:min 1}]
  [:redmine :project]  [:string {:min 1}]
  [:redmine :subject]  [:string {:min 1}]
  [:redmine :due]      [:string {:min 8}]}

 :process/stages
 [{:stage/id :mirrored
   :guards [[:signed-by :bridge [:redmine :url]]]}

  {:stage/id :open
   :after [:mirrored]
   :guards [[:signed-by :bridge [:redmine :state]]
            [:fact= [:redmine :state] :open]]}

  {:stage/id :closed
   :after [:mirrored]
   :guards [[:signed-by :bridge [:redmine :state]]
            [:fact= [:redmine :state] :closed]]}]}
