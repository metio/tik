;;
;; SYNTHETIC fixture, not recorded from any server. It is written to look
;; like the answer of an Odoo 12.0 `fields_get` on project.task with the
;; attributes tik.odoo-describe/field-attributes asks for, as JSON-RPC
;; parses it (keyword field names). Field names, types and relations follow
;; the project.task fields the project.task profile reads. Whether Odoo 12
;; exports `track_visibility` through fields_get at all is UNVERIFIED; the
;; values below assume it does. Replace with a recorded answer once one
;; exists (support intake ticket R1).
{:version {:server_version "12.0"
           :server_version_info [12 0 0 "final" 0 ""]
           :protocol_version 1}
 :fields {:name {:string "Title" :type "char" :required true :readonly false
                 :track_visibility "always"}
          :stage_id {:string "Stage" :type "many2one" :relation "project.task.type"
                     :required false :readonly false :track_visibility "onchange"}
          :user_id {:string "Assigned to" :type "many2one" :relation "res.users"
                    :required false :readonly false :track_visibility "always"}
          :project_id {:string "Project" :type "many2one" :relation "project.project"
                       :required false :readonly false :track_visibility "onchange"}
          :create_date {:string "Created on" :type "datetime" :required false :readonly true}
          :write_date {:string "Last Updated on" :type "datetime" :required false :readonly true}
          :kanban_state {:string "Kanban State" :type "selection" :required true :readonly false
                         :selection [["normal" "Grey"] ["done" "Green"] ["blocked" "Red"]]
                         :track_visibility "onchange"}
          :priority {:string "Priority" :type "selection" :required false :readonly false
                     :selection [["0" "Normal"] ["1" "Important"]]}
          :date_deadline {:string "Deadline" :type "date" :required false :readonly false}
          :tag_ids {:string "Tags" :type "many2many" :relation "project.tags"
                    :required false :readonly false}
          :partner_id {:string "Customer" :type "many2one" :relation "res.partner"
                       :required false :readonly false}
          :description {:string "Description" :type "html" :required false :readonly false}
          :active {:string "Active" :type "boolean" :required false :readonly false}
          :message_ids {:string "Messages" :type "one2many" :relation "mail.message"
                        :required false :readonly false}}}
